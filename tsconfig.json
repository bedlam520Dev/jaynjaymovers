{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/fonts": ["./src/app/fonts/*"],
      "@/types": ["./src/types/*"],
      "@/components": ["./src/components/*"],
      "@/components/ui": ["./src/components/ui/*"],
      "@/pages": ["./src/app/*"],
      "@/hooks": ["./src/hooks/*"],
      "@/lib": ["./src/lib/*"],
      "@/utils": ["./src/utils/*"],
      "@/contexts": ["./src/contexts/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules/**/*",
    "e2e/**/*",
    "storybook-static/**/*",
    "_dev/**/*",
    "_devlogs/**/*",
    ".storybook/**/*",
    ".vscode/**/*",
    ".kilo/**/*",
    "src/components/**/*",
    ".opencode/**/*",
    "playwright-report/**/*",
    "test-results/**/*",
    "supabase/**/*",
    "src/lib/__tests__/**/*"
  ]
}
