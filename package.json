  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f .env.development -- next dev",
    "build": "dotenvx run -f .env.production -- next build",
    "start": "dotenvx run -f .env.production -- next start",
    "bst": "dotenvx run -f .env.testing -- next build && dotenvx run -f .env.testing -- next start && dotenvx run -f .env.testing -- vitest --watch && dotenvx run -f .env.testing -- playwright test && dotenvx run -f .env.testing -- vitest",
    "clean:nuke": "rm -rf .next tsconfig.tsbuildinfo node_modules pnpm-lock.yaml > _devlogs/clean/clean-nuke-$(date +%Y%m%d-%H%M%S).log 2>&1",
    "tschk": "tsc --noEmit > _devlogs/tschk/tschk-$(date +%Y%m%d-%H%M%S).log 2>&1",
    "lint": "oxlint > _devlogs/oxlint/lint-$(date +%Y%m%d-%H%M%S).log 2>&1",
    "lint:fix": "oxlint --fix > _devlogs/oxlint/lint-fix-$(date +%Y%m%d-%H%M%S).log 2>&1",
    "format:check": "oxfmt --check > _devlogs/oxfmt/fmt-chk-$(date +%Y%m%d-%H%M%S).log 2>&1",
    "format": "oxfmt > _devlogs/oxfmt/fmt-$(date +%Y%m%d-%H%M%S).log 2>&1",
    "validate": "pnpm tschk && pnpm lint && pnpm format > _devlogs/validate/validate-$(date +%Y%m%d-%H%M%S).log 2>&1",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
